# Copy the values you need into .env.development.local (git-ignored) or set them
# in EAS environment variables. EXPO_PUBLIC_* values are inlined into the JS
# bundle, so never put secrets here (OAuth client ids are public).

# GraphQL API reachable from the device/simulator.
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql

# --- Google Sign-In -----------------------------------------------------------
# Google sign-in uses a native module: it needs a development build
# (`npx expo run:ios` / `npx expo run:android`, or an EAS build). It does not
# work in Expo Go; there the button shows "no disponible".
# If any of the ids below is missing, the button also shows "no disponible".

# WEB OAuth client id (Google Cloud > APIs & Services > Credentials). The app
# requests the ID token for this audience, and the API must list the same id
# in GOOGLE_CLIENT_IDS. Required on iOS and Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS OAuth client id (application type iOS, bundle id com.karlhub.finnitapp).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Reversed iOS client id, e.g. com.googleusercontent.apps.1234567890-abcdef.
# app.config.ts adds the Google Sign-In config plugin (URL scheme in Info.plist)
# only when this is set; run `npx expo prebuild --clean` (or rebuild) after
# changing it.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Android needs no client id in code, but Google Cloud must have an Android
# OAuth client with package name com.karlhub.finnitapp and the SHA-1 of the
# signing key (debug keystore for local builds, plus the EAS / Play signing key).
