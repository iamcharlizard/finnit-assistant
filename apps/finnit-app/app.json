{
  "expo": {
    "name": "finnit-app",
    "slug": "finnit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/finnit-icon-1024.png",
    "scheme": "finnitapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karlhub.finnitapp"
    },
    "android": {
      "package": "com.karlhub.finnitapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand/finnit-adaptive-icon-1024.png",
        "backgroundColor": "#12131a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/brand/finnit-favicon-light.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/finnit-splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f8f9fa",
          "dark": {
            "image": "./assets/images/brand/finnit-splash-icon-dark.png",
            "backgroundColor": "#12131a"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
