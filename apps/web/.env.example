# Finnit API base URL, used only by the Next server (never sent to the browser).
FINNIT_API_URL=http://localhost:3000

# Google sign-in ("Continuar con Google"), OAuth client of type "Web
# application" in Google Cloud. Only the Next server uses them; the secret
# never reaches the browser. Register this authorized redirect URI for each
# origin: <origin>/api/auth/google/callback
# (e.g. http://localhost:3001/api/auth/google/callback). The API must use the
# same client id (in its GOOGLE_CLIENT_IDS) to accept the ID tokens. When they
# are empty, the Google button answers "no está disponible".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
