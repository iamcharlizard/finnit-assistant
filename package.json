{
  "name": "finnit-assistant",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start:api": "turbo run start:dev --filter=@finnit/api",
    "api:dev": "turbo run build --filter=@finnit/database && turbo run start:dev --filter=@finnit/api",
    "app:start": "turbo run start --filter=finnit-app",
    "app:ios": "turbo run ios --filter=finnit-app",
    "app:ios:device": "pnpm --filter finnit-app run ios:device",
    "app:android": "turbo run android --filter=finnit-app",
    "app:web": "turbo run web --filter=finnit-app",
    "web:dev": "turbo run dev --filter=@finnit/web",
    "web:build": "turbo run build --filter=@finnit/web",
    "storybook": "turbo run dev --filter=@finnit/storybook",
    "storybook:build": "turbo run build --filter=@finnit/storybook",
    "db:migrate": "turbo run db:migrate:dev --filter=@finnit/database",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@finnit/database",
    "db:generate": "turbo run db:generate --filter=@finnit/database",
    "db:seed": "turbo run db:seed --filter=@finnit/database",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.3.0"
}
