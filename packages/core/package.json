  },
  "devDependencies": {
    "@finnit/eslint-config": "workspace:*",
    "@finnit/typescript-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "19.3.0",
    "eslint": "^10.4.0",
    "react": "19.3.0",
    "tsx": "^4.22.3",
    "typescript": "5.9.3"
  }
}
