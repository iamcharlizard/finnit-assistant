# Copy to .env.remote (git-ignored) for `pnpm db:pull <production|testing>`.
# The databases are only reachable inside Dokploy's Docker network on the
# Hetzner server: the script connects over SSH and runs pg_dump there.

# SSH destination: user@host, or a Host alias from ~/.ssh/config.
SERVER_SSH=root@your-server

# Optional: per environment, if it differs from SERVER_SSH.
# PRODUCTION_SSH=
# TESTING_SSH=

# Optional: regex of the database container name. Dokploy adds a random
# suffix to the App Name (finnit-db-xxxxxx, finnit-db-test-xxxxxx).
# PRODUCTION_DB_CONTAINER=^finnit-db-[a-z0-9]+([.]|$)
# TESTING_DB_CONTAINER=^finnit-db-test-[a-z0-9]+([.]|$)

# Optional: database and user inside the container. By default they are read
# from the container (POSTGRES_DB / POSTGRES_USER).
# PRODUCTION_DB_NAME=finnit
# PRODUCTION_DB_USER=finnit
# TESTING_DB_NAME=finnit
# TESTING_DB_USER=finnit

# Optional: how to call docker on the server (e.g. "sudo docker").
# REMOTE_DOCKER=docker
