{
  "name": "@finnit/database",
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed:init": "prisma db seed",
    "db:seed": "prisma generate && node prisma/seeders/seed.js",
    "db:seed:clean": "prisma generate && node prisma/seeders/seed.js --clean",
    "db:reset": "prisma migrate reset --force",
    "db:reset:seed": "prisma migrate reset --force && prisma generate && node prisma/seeders/seed.js",
    "db:seed:enhanced": "tsx scripts/enhanced-seed.ts",
    "db:generate": "prisma generate",
    "db:validate": "tsx scripts/validate-schema.ts",
    "db:backup": "psql $DATABASE_URL -f scripts/backup.sql",
    "db:rollback": "psql $DATABASE_URL -f scripts/rollback.sql",
    "dev": "tsup src/* --watch",
    "format": "prisma format",
    "lint": "eslint . --max-warnings 0",
    "studio": "prisma studio"
  },
  "prisma": {
    "seed": "prisma generate && node prisma/seeders/seed.js"
  },
  "devDependencies": {
    "@finnit/eslint-config": "workspace:*",
    "@finnit/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^10.4.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "pg": "^8.21.0"
  }
}
