// -----------------------------------------------------
// Prisma Schema — Finnit Assistant (MVP)
// DB: PostgreSQL
// -----------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------- Enums ------------------------

enum AccountType {
  cash
  debit
  credit
  savings
  ewallet
}

enum TransactionType {
  income
  expense
  transfer
  adjustment
}

enum TransactionSource {
  manual
  imported
  ocr
  sms
  statement // movement imported from a card statement PDF
}

enum NotificationType {
  budget
  debt_due
  recurring
  summary
  balance_mismatch
  uncategorized
}

// Why a movement looks like a transfer between the user's own accounts.
enum TransferSuggestionReason {
  pair // the opposite movement, same amount, is in another own account
  text // its description reads like a transfer (SPEI, traspaso, …)
  rule // a merchant alias says it goes to one of the user's accounts
}

enum TransferSuggestionStatus {
  pending
  accepted
  dismissed
}

enum NotificationStatus {
  scheduled
  sent
  read
  dismissed
}

enum BankProvider {
  belvo
  paybook
  syncfy
  other
}

enum BankConnectionStatus {
  active
  revoked
  error
}

enum ReconciliationItemType {
  balance
  transaction
}

enum ReconciliationState {
  confirmed
  corrected
  ignored
}

enum DebtKind {
  loan
  card
  other
}

// Only for kind = loan.
enum LoanType {
  institutional // bank or lending company: fixed payments and term
  personal // family or friends: flexible payments, may grow
  purchase_financing // Kueski, Didi Paga Después: each purchase adds installments on the same due dates
}

// How the amount to repay of a loan (or charge) was given.
enum LoanInterestMode {
  rate // principal + annual rate, French amortization
  total_amount // the user entered the total to repay
  installment_amount // the user entered the amount of each payment
}

enum DebtStatus {
  active
  paid_off
}

// Where the money of a loan or charge went.
/// How someone lent the money (personal loans).
enum LendingMethod {
  cash
  transfer
  credit_card
  debit_card
  other
}

enum DebtChargeDestination {
  deposit // into one of the user's accounts
  purchase // paid for something directly (no account movement)
}

enum RecurringFrequency {
  weekly
  biweekly // every 14 days
  semimonthly // "quincenal": the 15th and the last day of the month
  monthly
  bimonthly
  quarterly
  semiannual
  yearly
}

enum RecurringExpenseKind {
  subscription // streaming, apps
  utility // power, water, internet, phone
  loan
  installment // "meses sin intereses" on a credit card
  insurance
  housing // rent, maintenance fees
  membership // gym, clubs
  other
}

// automatic: charged to a card/account by itself; marked paid when a statement
//            or bank movement is reconciled against it.
// manual:    the user pays it and confirms it.
// reminder:  only reminds; occurrences carry no payment state.
enum RecurringTrackingMode {
  automatic
  manual
  reminder
}

enum OccurrenceStatus {
  upcoming
  paid
  skipped
  missed
}

enum OccurrenceMatchSource {
  manual
  statement
  bank
}

enum StatementSource {
  pdf
  belvo
}

enum StatementStatus {
  uploaded
  processing
  needs_review
  confirmed
  failed
}

enum ImportedLineKind {
  charge
  payment
  refund
  fee
  interest
  installment
  deposit // money received in a debit/savings account (income)
}

enum UserRole {
  user
  admin
}

enum AiFeatureKey {
  statement_parsing
  transaction_categorization
  recurring_classification
  receipt_parsing
  translation
  screenshot_parsing
}

/// Whether a category is for spending or income (subcategories share their parent's).
enum CategoryKind {
  expense
  income
}

/// Where a category name translation came from.
enum TranslationSource {
  seed // default categories (migration / sign-up)
  google // Google Cloud Translation
  ai // AI fallback when Google is unavailable
  user // the text the user typed, in its own language
}

enum AiProvider {
  anthropic
  openai
  google
}

/// Who set a transaction's category (or proposed a pending suggestion).
enum CategorySource {
  manual // the user picked it
  rule // a merchant rule, an alias with a category, or the frequency heuristic
  ai // AI suggestion the user accepted
  bank // came with a bank import
}

/// How a merchant alias pattern is compared with the original text.
enum AliasMatchType {
  contains
  starts_with
  exact
  regex // Postgres ~* (case-insensitive), evaluated only in the database
}

enum ImportedLineStatus {
  pending // will become a new transaction on confirm
  matched // linked to an existing transaction
  created // transaction created on confirm
  ignored
}

/// Lifecycle of a receipt photo: uploaded → processing → needs_review →
/// confirmed (transaction created or photo attached) | discarded; failed on errors.
enum ReceiptStatus {
  uploaded
  processing
  needs_review
  confirmed
  discarded
  failed
}

/// How a receipt's fields were extracted.
enum ReceiptRoute {
  cfdi_qr // the SAT QR of a printed CFDI (exact total and tax ID)
  ocr_rules // OCR text + local rules
  ai // OCR text sent to the AI fallback (receipt_parsing feature)
}

enum ReceiptConfidence {
  high // total and date, cross-checked (QR total or subtotal + tax)
  medium // total and date
  low // something is missing
}

// ---------------------- Models -----------------------

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  passwordHash     String? // null: signs in only with Google
  role             UserRole  @default(user)
  isMaster         Boolean   @default(false) // at most one (partial unique index in SQL)
  googleSubject    String?   @unique // Google account id ("sub"), linked on first Google sign-in
  disabledAt       DateTime?
  lastLoginAt      DateTime?
  tokenVersion     Int       @default(0) // bumped to revoke every open session
  locale           String    @default("es") @db.VarChar(5) // UI / data language: 'es' | 'en'
  googlePictureUrl String? // "picture" of the Google account, refreshed on each Google sign-in
  avatarKey        String? // uploaded profile photo (S3 key, users/<id>/avatars/…); wins over Google's
  avatarUpdatedAt  DateTime? // when the photo last changed (cache-busting version)
  invitedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invitedBy      User?       @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers   User[]      @relation("UserInvitations")
  aiFeatureEdits AiFeature[]

  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  statementImports  StatementImport[]
  budgets           Budget[]
  goals             Goal[]
  contacts          Contact[]
  notifications     Notification[]
  bankConnections   BankConnection[]
  bankProviderUsers BankProviderUser[]
  reconciliations   ReconciliationSession[]
  tags              Tag[]
  Debt              Debt[]

  recurringSuggestionStates RecurringSuggestionState[]
  merchantAliases           MerchantAlias[]
  merchantRules             MerchantRule[]
  receiptImports            ReceiptImport[]
  screenshotImports         ScreenshotImport[]
  transferSuggestions       TransferSuggestion[]
  merchantTaxIds            MerchantTaxId[]
  hiddenCategories          CategoryHidden[]
}

model Account {
  id             String      @id @default(uuid())
  userId         String
  type           AccountType
  name           String
  currency       String      @db.VarChar(3)
  balanceCurrent Decimal     @db.Decimal(18, 2)
  metadata       Json?
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user                        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCardTerms             CreditCardTerms?
  transactions                Transaction[]
  linkedAccounts              LinkedAccount[]
  // Linked accounts: the one open adjustment that makes the recorded balance
  // match the bank's ("Diferencia con el banco"); recalculated on each sync
  // and removed when the missing movements are recorded.
  bankDifferenceTransactionId String?               @unique
  bankDifferenceTransaction   Transaction?          @relation("account_bank_difference", fields: [bankDifferenceTransactionId], references: [id], onDelete: SetNull)
  reconciliationItems         ReconciliationItem[]
  debtsLinked                 Debt[]                @relation("debt_linked_account")
  recurringExpenses           RecurringExpense[]
  statementImports            StatementImport[]
  importedLines               ImportedTransaction[] @relation("imported_account")
  receiptSuggestions          ReceiptImport[]       @relation("receipt_suggested_account")
  screenshotImports           ScreenshotImport[]    @relation("screenshot_account")
  transferAliases             MerchantAlias[]       @relation("alias_transfer_account")
  transferSuggestions         TransferSuggestion[]  @relation("transfer_suggestion_account")

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, type])
}

model CreditCardTerms {
  accountId          String   @id
  statementDay       Int      @db.SmallInt
  paymentDueDay      Int      @db.SmallInt
  interestRateAnnual Decimal? @db.Decimal(9, 4)
  minPaymentRule     String?
  gracePeriodDays    Int?
  updatedAt          DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// userId null + isDefault: the global catalog (default-categories.ts, synced on
/// start; nobody edits it). Otherwise the user's own category, seen only by them.
/// Global keys are unique through a partial index (Category_global_key_key).
model Category {
  id        String       @id @default(uuid())
  userId    String? // null => global catalog
  parentId  String?
  name      String // English original; localized names live in CategoryTranslation
  key       String? // catalog key, e.g. categories.food.groceries
  isDefault Boolean      @default(false)
  kind      CategoryKind @default(expense)
  icon      String? // icon key the clients know; null => the parent's / by name
  color     String? // color key the clients know; null => the icon's
  sortOrder Int?
  createdAt DateTime     @default(now())

  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent            Category?             @relation("category_to_self", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]            @relation("category_to_self")
  transactions      Transaction[]         @relation("transaction_category")
  budgetCaps        BUDGET_CATEGORY[]
  recurringExpenses RecurringExpense[]
  translations      CategoryTranslation[]

  recurringSuggestionStates RecurringSuggestionState[]
  suggestedForTransactions  Transaction[]              @relation("transaction_suggested_category")
  merchantAliases           MerchantAlias[]
  merchantRules             MerchantRule[]
  receiptSuggestions        ReceiptImport[]            @relation("receipt_suggested_category")
  merchantTaxIds            MerchantTaxId[]
  debtPurposes              Debt[]                     @relation("debt_purpose_category")
  debtChargePurposes        DebtCharge[]               @relation("debt_charge_purpose_category")
  hiddenBy                  CategoryHidden[]

  @@unique([userId, name], name: "category_user_name_unique")
  @@unique([userId, key], name: "category_user_key_unique")
  @@index([userId])
  @@index([parentId])
}

/// A global category a user hid from their pickers (pivot).
model CategoryHidden {
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

/// Category name per locale ('es' | 'en'). Child rows of Category (cascade).
model CategoryTranslation {
  id         String            @id @default(uuid())
  categoryId String
  locale     String            @db.VarChar(5)
  name       String
  source     TranslationSource
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Transaction {
  id                  String            @id @default(uuid())
  userId              String
  accountId           String
  categoryId          String?
  type                TransactionType
  amount              Decimal           @db.Decimal(18, 2)
  // What it adds (+) or takes (−) from its account's balance, signed; a
  // pending movement keeps it but doesn't count until confirmed. Null only
  // for old adjustments whose direction couldn't be worked out.
  balanceEffect       Decimal?          @db.Decimal(18, 2)
  currency            String            @db.VarChar(3)
  txnDate             DateTime          @db.Date
  description         String?
  merchantName        String?
  isPending           Boolean           @default(false)
  // "En proceso": the bank shows it but hasn't applied it yet. Unlike
  // isPending it counts in the balance and totals; it is only marked, and
  // clears when the bank's applied movement is linked to it (or by hand).
  inProcess           Boolean           @default(false)
  isRecurringInstance Boolean           @default(false)
  source              TransactionSource
  externalId          String?           @unique
  // Merchant aliases (feature 17). The original description/merchant is never
  // modified. aliasId is the matching alias rule, materialized whenever the
  // user's aliases change; aliasName/isPrivate are one-off overrides.
  aliasId             String?
  aliasName           String?
  isPrivate           Boolean           @default(false)
  // Categorization (feature 16). null categorySource: set before it existed.
  categorySource      CategorySource?
  suggestedCategoryId String? // pending suggestion, not applied yet
  suggestedBy         CategorySource? // 'rule' | 'ai'
  // A movement turned into a transfer side: the type it had, restored when
  // the conversion is undone. Null otherwise (also for a side the conversion
  // created, which undoing deletes).
  originalType        TransactionType?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category          Category?      @relation("transaction_category", fields: [categoryId], references: [id], onDelete: SetNull)
  alias             MerchantAlias? @relation(fields: [aliasId], references: [id], onDelete: SetNull)
  suggestedCategory Category?      @relation("transaction_suggested_category", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)

  // Relaciones inversas para Transfer (1–1)
  transferFrom Transfer? @relation("transfer_from")
  transferTo   Transfer? @relation("transfer_to")

  attachments               Attachment[]
  debtPayment               DebtPayment?
  debtCharge                DebtCharge?
  debtDisbursement          Debt?                 @relation("debt_disbursement")
  bankDifferenceOf          Account?              @relation("account_bank_difference")
  goalContributions         GoalContribution[] // <-- ahora 1–N (fix)
  transactionTags           TransactionTag[]
  importedMatches           ImportedTransaction[] @relation("imported_matched")
  recurringPayment          RecurringOccurrence?
  receiptImport             ReceiptImport?        @relation("receipt_transaction")
  receiptMatches            ReceiptImport[]       @relation("receipt_matched_transaction")
  transferSuggestion        TransferSuggestion?   @relation("transfer_suggestion_transaction")
  transferSuggestionMatches TransferSuggestion[]  @relation("transfer_suggestion_counterpart")

  @@index([userId, txnDate(sort: Desc)])
  @@index([userId, accountId, txnDate(sort: Desc)])
  @@index([source])
  @@index([aliasId])
  @@index([suggestedCategoryId])
}

/// Display name (and optional category / privacy) for the movements whose
/// original text matches `pattern` (feature 17). Matching runs in SQL
/// (unaccent + lower, or ~* for regex) and is materialized in
/// Transaction.aliasId.
model MerchantAlias {
  id                String         @id @default(uuid())
  userId            String
  matchType         AliasMatchType
  pattern           String         @db.VarChar(200)
  displayName       String         @db.VarChar(80)
  categoryId        String?
  isPrivate         Boolean        @default(false)
  priority          Int            @default(0)
  active            Boolean        @default(true)
  // "These go to my account X": a matching synced movement is suggested as
  // a transfer to it (never converted on its own).
  transferAccountId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferAccount Account?      @relation("alias_transfer_account", fields: [transferAccountId], references: [id], onDelete: SetNull)
  transactions    Transaction[]

  @@index([userId, active])
  @@index([categoryId])
  @@index([transferAccountId])
}

/// Learned merchant -> category (feature 16): created when the user
/// categorizes or accepts a suggestion. `pattern` is the normalized merchant
/// (normalizeMerchant); lookups compare it without spaces.
model MerchantRule {
  id         String   @id @default(uuid())
  userId     String
  pattern    String   @db.VarChar(200)
  categoryId String
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([categoryId])
}

model Transfer {
  id          String    @id @default(uuid())
  fromTxnId   String    @unique
  toTxnId     String    @unique
  amount      Decimal   @db.Decimal(18, 2)
  // Made by turning an existing expense/income into a transfer (it can be
  // undone); null for transfers registered as such.
  convertedAt DateTime?
  createdAt   DateTime  @default(now())

  fromTxn Transaction @relation("transfer_from", fields: [fromTxnId], references: [id], onDelete: Restrict)
  toTxn   Transaction @relation("transfer_to", fields: [toTxnId], references: [id], onDelete: Restrict)

  @@unique([fromTxnId, toTxnId])
}

/// A movement that looks like a transfer between the user's own accounts,
/// found when bank movements arrive. The user confirms it (it becomes a
/// transfer), says it went to someone else, or dismisses it; reviewed
/// movements are never suggested again.
model TransferSuggestion {
  id                       String                   @id @default(uuid())
  userId                   String
  transactionId            String                   @unique
  counterpartTransactionId String?
  counterpartAccountId     String?
  reason                   TransferSuggestionReason
  status                   TransferSuggestionStatus @default(pending)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction            Transaction  @relation("transfer_suggestion_transaction", fields: [transactionId], references: [id], onDelete: Cascade)
  counterpartTransaction Transaction? @relation("transfer_suggestion_counterpart", fields: [counterpartTransactionId], references: [id], onDelete: SetNull)
  counterpartAccount     Account?     @relation("transfer_suggestion_account", fields: [counterpartAccountId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([counterpartTransactionId])
  @@index([counterpartAccountId])
}

// Files live in the private S3 bucket (fileKey); they are only served by the
// API to the owner of the transaction. fileUrl is legacy (external links).
model Attachment {
  id            String   @id @default(uuid())
  transactionId String
  fileKey       String?  @unique // S3 object key
  fileName      String?
  fileUrl       String?
  fileType      String
  fileSize      Int?
  extra         Json?
  uploadedAt    DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model RecurringExpense {
  id                String                @id @default(uuid())
  userId            String
  name              String
  kind              RecurringExpenseKind
  trackingMode      RecurringTrackingMode
  frequency         RecurringFrequency
  interval          Int                   @default(1) @db.SmallInt // every N periods
  startDate         DateTime              @db.Date
  endDate           DateTime?             @db.Date
  amount            Decimal               @db.Decimal(18, 2)
  isVariableAmount  Boolean               @default(false) // e.g. power bill: amount is an estimate
  currency          String                @db.VarChar(3)
  accountId         String? // account or card it is paid with
  categoryId        String?
  debtId            String?               @unique // loan this expense pays
  merchantPattern   String? // text that identifies it in statements, e.g. "NETFLIX"
  installmentsTotal Int?                  @db.SmallInt
  installmentsPaid  Int                   @default(0) @db.SmallInt
  active            Boolean               @default(true)
  notes             String?
  nextDueDate       DateTime?             @db.Date
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category    Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  debt        Debt?                 @relation(fields: [debtId], references: [id], onDelete: SetNull)
  occurrences RecurringOccurrence[]

  @@unique([userId, name])
  @@index([userId, active])
  @@index([accountId])
}

model RecurringOccurrence {
  id                 String                 @id @default(uuid())
  recurringExpenseId String
  dueDate            DateTime               @db.Date
  // Set when the user moved it: the date the schedule gave it (it is not
  // generated again there; per-date amounts are looked up by it).
  originalDueDate    DateTime?              @db.Date
  expectedAmount     Decimal                @db.Decimal(18, 2)
  status             OccurrenceStatus       @default(upcoming)
  transactionId      String?                @unique
  paidAt             DateTime?
  matchedBy          OccurrenceMatchSource?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  recurringExpense RecurringExpense      @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  transaction      Transaction?          @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  importedLines    ImportedTransaction[]

  @@unique([recurringExpenseId, dueDate])
  @@index([status, dueDate])
}

/// What happened to a detected recurring-payment suggestion (feature 15):
/// dismissed, accepted, or classified by AI (cached so the AI runs once per
/// suggestion). `fingerprint` identifies the detected group (merchant +
/// currency), it is not a foreign key.
model RecurringSuggestionState {
  id               String                @id @default(uuid())
  userId           String
  fingerprint      String                @db.VarChar(64)
  dismissedAt      DateTime?
  acceptedAt       DateTime?
  aiName           String?
  aiKind           RecurringExpenseKind?
  aiCategoryId     String?
  aiModel          String? // provider model id that classified it
  classifiedAt     DateTime?
  // Loan details proposed by AI when the user turns the suggestion into a loan.
  aiLoanType       LoanType?
  aiLenderName     String?
  loanClassifiedAt DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiCategory Category? @relation(fields: [aiCategoryId], references: [id], onDelete: SetNull)

  @@unique([userId, fingerprint])
  @@index([aiCategoryId])
}

model StatementImport {
  id                String          @id @default(uuid())
  userId            String
  accountId         String
  source            StatementSource
  status            StatementStatus @default(uploaded)
  parser            String? // banamex_v1 | claude | belvo
  periodStart       DateTime?       @db.Date
  periodEnd         DateTime?       @db.Date
  statementDate     DateTime?       @db.Date // cut-off date
  paymentDueDate    DateTime?       @db.Date
  previousBalance   Decimal?        @db.Decimal(18, 2)
  totalCharges      Decimal?        @db.Decimal(18, 2)
  totalCredits      Decimal?        @db.Decimal(18, 2)
  statementBalance  Decimal?        @db.Decimal(18, 2) // balance at cut-off
  noInterestPayment Decimal?        @db.Decimal(18, 2) // "pago para no generar intereses"
  minimumPayment    Decimal?        @db.Decimal(18, 2)
  currency          String          @db.VarChar(3)
  fileKey           String? // S3 object key
  fileHash          String? // sha256 of the uploaded file
  computedTotal     Decimal?        @db.Decimal(18, 2) // sum of extracted lines
  difference        Decimal?        @db.Decimal(18, 2) // statement totals vs extracted lines
  errorMessage      String?
  rawExtraction     Json?
  confirmedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lines   ImportedTransaction[]

  @@unique([accountId, periodEnd])
  @@unique([userId, fileHash])
  @@index([userId, createdAt(sort: Desc)])
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  year        Int      @db.SmallInt
  month       Int      @db.SmallInt
  currency    String   @db.VarChar(3)
  amountTotal Decimal? @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BUDGET_CATEGORY[]

  @@unique([userId, year, month])
  @@index([userId])
}

model BUDGET_CATEGORY {
  id         String  @id @default(uuid())
  budgetId   String
  categoryId String
  capAmount  Decimal @db.Decimal(18, 2)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([categoryId])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(18, 2)
  dueDate       DateTime? @db.Date
  currentAmount Decimal   @default(0) @db.Decimal(18, 2)
  currency      String    @db.VarChar(3)
  createdAt     DateTime  @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@unique([userId, name])
}

model GoalContribution {
  id            String   @id @default(uuid())
  goalId        String
  transactionId String? // 1–N: una transacción puede aportar a varias metas
  amount        Decimal  @db.Decimal(18, 2)
  date          DateTime @db.Date

  goal        Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@index([transactionId])
}

model Debt {
  id                        String                 @id @default(uuid())
  userId                    String
  name                      String
  // Loans: what the first amount was (the first purchase, what it was lent
  // for); the label of its installments, like a charge's description.
  description               String?
  kind                      DebtKind
  principal                 Decimal                @db.Decimal(18, 2)
  interestRateAnnual        Decimal?               @db.Decimal(9, 4)
  minPaymentAmount          Decimal?               @db.Decimal(18, 2)
  startDate                 DateTime?              @db.Date
  dueDate                   DateTime?              @db.Date
  linkedAccountId           String?
  loanType                  LoanType?
  status                    DebtStatus             @default(active)
  lenderName                String? // personal loans: who lent the money
  paymentFrequency          RecurringFrequency?
  installmentsTotal         Int?                   @db.SmallInt
  installmentAmount         Decimal?               @db.Decimal(18, 2)
  totalToRepay              Decimal?               @db.Decimal(18, 2) // principal + interest; null = principal
  interestMode              LoanInterestMode?
  includesVat               Boolean                @default(false) // 16% VAT on interest (Mexico)
  // Opening fee (comisión por apertura), taken from the money deposited:
  // the deposit is principal − fee, the debt is still the whole principal.
  openingFee                Decimal?               @db.Decimal(18, 2)
  // Fixed fee charged with every payment (administración, seguro), VAT
  // included; part of each installment, not interest.
  periodicFee               Decimal?               @db.Decimal(18, 2)
  destination               DebtChargeDestination?
  // destination = deposit: whether the money was added to an account's
  // balance. False = already spent (e.g. an old loan): only the debt counts.
  depositAddsToBalance      Boolean                @default(true)
  // The deposit of the borrowed money into an account (destination = deposit).
  disbursementTransactionId String?                @unique
  // What the borrowed money was for (informative: the expense is the payments).
  purposeCategoryId         String?
  // Personal loans: the contact who lent it (lenderName keeps their name).
  lenderContactId           String?
  // Personal loans: how the initial amount was lent.
  lendingMethod             LendingMethod?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @default(now()) @updatedAt

  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments                DebtPayment[]
  charges                 DebtCharge[]
  linkedAccount           Account?          @relation("debt_linked_account", fields: [linkedAccountId], references: [id], onDelete: SetNull)
  disbursementTransaction Transaction?      @relation("debt_disbursement", fields: [disbursementTransactionId], references: [id], onDelete: SetNull)
  purposeCategory         Category?         @relation("debt_purpose_category", fields: [purposeCategoryId], references: [id], onDelete: SetNull)
  lenderContact           Contact?          @relation(fields: [lenderContactId], references: [id], onDelete: SetNull)
  recurringExpense        RecurringExpense?

  @@unique([userId, name])
  @@index([userId])
}

/// A person the user deals with (e.g. who lent them money). Only the name
/// for now; payment details may come later.
model Contact {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  debts Debt[]

  @@unique([userId, name])
  @@index([userId])
}

/// Money added to a debt after it was created: another personal loan, or a
/// purchase financed with Kueski / Didi (with its own interest and term).
model DebtCharge {
  id                   String                @id @default(uuid())
  debtId               String
  date                 DateTime              @db.Date
  description          String?
  principal            Decimal               @db.Decimal(18, 2)
  totalToRepay         Decimal               @db.Decimal(18, 2)
  installments         Int?                  @db.SmallInt
  // Installments paid before it was registered (historical payments).
  installmentsPaid     Int                   @default(0) @db.SmallInt
  // First due date of its installments; null = the first after `date`.
  firstPaymentDate     DateTime?             @db.Date
  // How its interest was given (null = no installments); the rate and VAT
  // when given by rate.
  interestMode         LoanInterestMode?
  interestRateAnnual   Decimal?              @db.Decimal(9, 4)
  includesVat          Boolean               @default(false)
  destination          DebtChargeDestination
  // destination = deposit: added to an account's balance (false = spent).
  depositAddsToBalance Boolean               @default(true)
  transactionId        String?               @unique // deposit into an account
  // What this money was for (informative: the expense is the payments).
  purposeCategoryId    String?
  // Personal loans: how it was lent (cash, transfer, their card…).
  lendingMethod        LendingMethod?
  createdAt            DateTime              @default(now())

  debt            Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction     Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  purposeCategory Category?     @relation("debt_charge_purpose_category", fields: [purposeCategoryId], references: [id], onDelete: SetNull)
  payments        DebtPayment[]

  @@index([debtId, date])
}

model DebtPayment {
  id            String   @id @default(uuid())
  debtId        String
  // Null for payments made before the debt was registered: they lower the
  // balance but are no movement, so they stay out of income/expense totals.
  transactionId String?
  isHistorical  Boolean  @default(false)
  amount        Decimal  @db.Decimal(18, 2)
  date          DateTime @db.Date
  // Historical installment of a charge (its `installmentsPaid`).
  chargeId      String?

  debt        Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  charge      DebtCharge?  @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@unique([transactionId])
  @@index([debtId, date])
  @@index([chargeId])
}

model Notification {
  id                String             @id @default(uuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  status            NotificationStatus @default(scheduled)
  scheduledAt       DateTime?
  sentAt            DateTime?
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// A bank login held by the aggregator (Syncfy credential). Finnit stores only
// the provider's ids, never the bank username or password.
model BankConnection {
  id                  String               @id @default(uuid())
  userId              String
  provider            BankProvider
  providerItemId      String               @unique // Syncfy id_credential
  providerUserId      String? // Syncfy id_user that owns the credential
  institution         String?
  status              BankConnectionStatus
  lastStatusCode      Int? // last provider job code (200 ok, 401 bad credentials, 410 needs token…)
  lastSyncedAt        DateTime?
  lastPullRequestedAt DateTime? // last time we asked the provider to refresh from the bank
  transactionsCursor  DateTime? // provider dt_refresh already imported
  errorMessage        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAccounts LinkedAccount[]

  @@index([userId])
}

// Finnit user <-> aggregator user (e.g. Syncfy id_user).
model BankProviderUser {
  id             String       @id @default(uuid())
  userId         String
  provider       BankProvider
  providerUserId String
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, userId])
  @@unique([provider, providerUserId])
}

// A bank account seen through a connection. Movements are imported only once
// it is linked to a Finnit account (accountId).
model LinkedAccount {
  id                String    @id @default(uuid())
  bankConnectionId  String
  accountId         String?
  providerAccountId String    @unique
  mask              String? // last 4 digits only
  officialName      String?
  type              String? // provider account type, e.g. "Credit Card"
  currency          String?   @db.VarChar(3)
  balance           Decimal?  @db.Decimal(18, 2)
  creditLimit       Decimal?  @db.Decimal(18, 2)
  availableCredit   Decimal?  @db.Decimal(18, 2)
  balanceUpdatedAt  DateTime?
  // The bank's balance at the last reconciliation, and when: the next sync
  // expects it plus the movements recorded since. Null = not reconciled yet.
  reconciledBalance Decimal?  @db.Decimal(18, 2)
  reconciledAt      DateTime?

  bankConnection BankConnection        @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  account        Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  importedTxs    ImportedTransaction[]

  @@index([bankConnectionId])
  @@index([accountId])
}

// Staging line for an external movement: a row of a statement PDF or a bank
// (Belvo) transaction. Reconciliation links it to a Transaction and, when it
// pays a recurring expense, to its occurrence.
model ImportedTransaction {
  id                   String             @id @default(uuid())
  accountId            String
  linkedAccountId      String?
  statementImportId    String?
  providerTxnId        String?            @unique
  kind                 ImportedLineKind   @default(charge)
  status               ImportedLineStatus @default(pending)
  amount               Decimal            @db.Decimal(18, 2) // positive; direction comes from `kind`
  currency             String             @db.VarChar(3)
  date                 DateTime           @db.Date
  postDate             DateTime?          @db.Date
  description          String?
  merchant             String?
  installmentNumber    Int?               @db.SmallInt
  installmentTotal     Int?               @db.SmallInt
  suggestedCategoryId  String?
  raw                  Json?
  matchedTransactionId String?
  matchedOccurrenceId  String?
  // Read from a screenshot of the bank's app.
  screenshotImportId   String?
  // The bank showed it "en proceso" (not applied yet).
  inProcess            Boolean            @default(false)
  importedAt           DateTime           @default(now())

  account            Account              @relation("imported_account", fields: [accountId], references: [id], onDelete: Cascade)
  linkedAccount      LinkedAccount?       @relation(fields: [linkedAccountId], references: [id], onDelete: Cascade)
  statementImport    StatementImport?     @relation(fields: [statementImportId], references: [id], onDelete: Cascade)
  screenshotImport   ScreenshotImport?    @relation(fields: [screenshotImportId], references: [id], onDelete: Cascade)
  matchedTransaction Transaction?         @relation("imported_matched", fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  matchedOccurrence  RecurringOccurrence? @relation(fields: [matchedOccurrenceId], references: [id], onDelete: SetNull)

  @@index([linkedAccountId, date])
  @@index([statementImportId])
  @@index([screenshotImportId])
  @@index([accountId, date])
}

model ReconciliationSession {
  id        String    @id @default(uuid())
  userId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  status    String    @default("open") // "open|closed"

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ReconciliationItem[]
}

model ReconciliationItem {
  id          String                 @id @default(uuid())
  sessionId   String
  accountId   String
  itemType    ReconciliationItemType
  referenceId String
  state       ReconciliationState
  details     Json?

  session ReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([accountId])
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionTags TransactionTag[]

  @@unique([userId, name])
  @@index([userId])
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

// Catalog of AI models the API may call. API keys live in env vars per
// provider (ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY), never here.
model AiModel {
  id          String     @id @default(uuid())
  provider    AiProvider
  modelId     String // provider's model name, e.g. "claude-haiku-5-5"
  label       String
  isActive    Boolean    @default(false)
  isDefault   Boolean    @default(false) // tried first; at most one row
  supportsPdf Boolean    @default(false)
  sortOrder   Int        @default(100) // fallback order after the default
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  features AiFeature[]

  @@unique([provider, modelId])
}

/// Per-feature AI settings, managed from the admin panel.
model AiFeature {
  key          AiFeatureKey @id
  enabled      Boolean      @default(true)
  aiModelId    String? // null: the catalog's default model
  useFallbacks Boolean      @default(true) // try other active models if this one fails
  updatedById  String?
  updatedAt    DateTime     @updatedAt

  aiModel   AiModel? @relation(fields: [aiModelId], references: [id], onDelete: SetNull)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// A receipt photo (feature 14): extracted fields wait for the user to
/// confirm them. One receipt = one transaction (no line items).
model ReceiptImport {
  id                   String             @id @default(uuid())
  userId               String
  status               ReceiptStatus      @default(uploaded)
  fileKey              String             @unique // S3 object key (users/<userId>/receipts/<id>.<ext>)
  fileName             String?
  fileHash             String // sha256 of the uploaded file
  mimeType             String
  fileSize             Int
  route                ReceiptRoute?
  confidence           ReceiptConfidence?
  total                Decimal?           @db.Decimal(18, 2)
  subtotal             Decimal?           @db.Decimal(18, 2)
  tax                  Decimal?           @db.Decimal(18, 2)
  currency             String             @default("MXN") @db.VarChar(3)
  date                 DateTime?          @db.Date
  merchantName         String?
  merchantTaxId        String?            @db.VarChar(13) // RFC of the issuer
  cardLast4            String?            @db.VarChar(4)
  suggestedAccountId   String?
  suggestedCategoryId  String?
  cfdiUuid             String?            @db.VarChar(36)
  ocrText              String?            @db.Text
  rawExtraction        Json?
  errorMessage         String?
  transactionId        String?            @unique // created or attached-to transaction, on confirm
  matchedTransactionId String? // existing movement that looks like this receipt
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestedAccount   Account?     @relation("receipt_suggested_account", fields: [suggestedAccountId], references: [id], onDelete: SetNull)
  suggestedCategory  Category?    @relation("receipt_suggested_category", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  transaction        Transaction? @relation("receipt_transaction", fields: [transactionId], references: [id], onDelete: SetNull)
  matchedTransaction Transaction? @relation("receipt_matched_transaction", fields: [matchedTransactionId], references: [id], onDelete: SetNull)

  @@unique([userId, fileHash])
  @@index([userId, createdAt(sort: Desc)])
  @@index([suggestedAccountId])
  @@index([suggestedCategoryId])
  @@index([matchedTransactionId])
}

/// A screenshot of a bank app's movement list: the account it shows and
/// its movements (stored as ImportedTransaction lines once the account is
/// known), waiting for the user to review them.
model ScreenshotImport {
  id            String        @id @default(uuid())
  userId        String
  status        ReceiptStatus @default(uploaded)
  fileKey       String        @unique // users/<userId>/screenshots/<id>.<ext>
  fileName      String?
  fileHash      String // sha256 of the uploaded file
  mimeType      String
  fileSize      Int
  route         ReceiptRoute?
  // What the screenshot says about the account ("Clásica Banamex **482").
  accountHint   String?
  last4         String?       @db.VarChar(4)
  // Detected, then chosen by the user; its lines are for this account.
  accountId     String?
  ocrText       String?       @db.Text
  // The movements as read (with what needs checking), before an account.
  rawExtraction Json?
  errorMessage  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account?              @relation("screenshot_account", fields: [accountId], references: [id], onDelete: SetNull)
  lines   ImportedTransaction[]

  @@unique([userId, fileHash])
  @@index([userId, createdAt(sort: Desc)])
  @@index([accountId])
}

/// Merchant tax ID (RFC) → name → category. userId null = global entry
/// (unique per taxId through a partial index in SQL); user entries learn
/// from confirmed receipts and win over the global ones.
model MerchantTaxId {
  id         String   @id @default(uuid())
  userId     String?
  taxId      String   @db.VarChar(13)
  name       String   @db.VarChar(120)
  categoryId String?
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, taxId])
  @@index([taxId])
  @@index([categoryId])
}
