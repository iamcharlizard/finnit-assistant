{
  "name": "@finnit/ui-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./theme.css": "./src/styles/theme.css",
    "./lib/tw": "./src/lib/tw.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./theme/tokens": "./src/theme/tokens.generated.ts",
    "./theme/*": "./src/theme/*.tsx",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/finance/*": "./src/components/finance/*.tsx",
    "./components/navigation/*": "./src/components/navigation/*.tsx",
    "./components/settings/*": "./src/components/settings/*.tsx"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "tokens": "tsx scripts/generate-tokens.ts"
  },
  "dependencies": {
    "@finnit/core": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "expo-blur": "*",
    "expo-glass-effect": "*",
    "lucide-react-native": "*",
    "react": "^19.3.0",
    "react-native": "*",
    "react-native-css": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@finnit/eslint-config": "workspace:*",
    "@finnit/typescript-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "19.3.0",
    "eslint": "^10.4.0",
    "expo-blur": "~58.0.5",
    "expo-glass-effect": "~58.0.5",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tsx": "^4.22.3",
    "typescript": "5.9.3"
  }
}
